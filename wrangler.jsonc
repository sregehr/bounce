// Bounce: the built app (dist/) served as static assets by a Worker.
// Unknown paths get index.html so the app's own routes (/vocals, /player, ...) work.
// Deploy with: npm run deploy (wrangler needs Node 22.12 or newer)
{
  "name": "mpc-mastering",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
