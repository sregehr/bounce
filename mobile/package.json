{
  "name": "bounce-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@convex-dev/auth": "^2.0.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "convex": "^1.50.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "tsx test/dsp.test.ts && tsx test/render.test.ts && tsx test/songs.test.ts",
    "e2e": "node test/e2e.mjs",
    "build:web": "expo export -p web",
    "build:site": "EXPO_PUBLIC_CONVEX_URL=${BOUNCE_SERVER_URL:-} EXPO_PUBLIC_CONVEX_SITE_URL= expo export -p web --output-dir dist-site",
    "deploy:server": "convex deploy --env-file ../.deploy-key.local --cmd 'npm run build:site' --cmd-url-env-var-name BOUNCE_SERVER_URL",
    "serve": "node scripts/serve.mjs",
    "serve:phone": "node scripts/serve.mjs --phone",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "private": true
}
