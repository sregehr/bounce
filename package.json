{
  "name": "bounce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "BOUNCE_PHONE=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm --prefix mobile run deploy:server && wrangler deploy",
    "deploy:site-only": "npm --prefix mobile run build:site && wrangler deploy",
    "deploy:prototype": "npm run build && wrangler deploy --assets ./dist"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
